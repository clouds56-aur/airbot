#!/usr/bin/env bash
set -euo pipefail

data_root=${AIRBOT_SDK_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/airbot-sdk}
constraints_root=${AIRBOT_SDK_CONSTRAINTS:-/usr/share/airbot-sdk}

usage() {
  printf '%s\n' 'Usage:' '  airbot-sdk install <5.1.6|5.2.2> [wheel-file]' '  airbot-sdk run <5.1.6|5.2.2> <command> [args...]' '  airbot-sdk python <5.1.6|5.2.2> [python args...]' '  airbot-sdk list'
  exit 2
}

version_details() {
  case $1 in
    5.1.6)
      sdk_python=3.12
      archive_name=5.1.6.zip
      archive_url=https://docs.airbots.online/assets/airbot-play/5.1.6/5.1.6.zip
      archive_sha256=9c1e657645a169d0cb11269186798c681f6a05a0aaecc60d5707d2041c2f6f73
      wheel_member=5.1.6/airbot_py-5.1.6-py3-none-any.whl
      wheel_name=airbot_py-5.1.6-py3-none-any.whl
      wheel_sha256=ca364deb444f40eddb9933e42dab96587727802f918744bfff698e132e453408
      ;;
    5.2.2)
      sdk_python=3.14
      archive_name=sdk_client_release.tar.gz
      archive_url=https://docs.airbots.online/assets/airbot-play/5.2/sdk_client_release.tar.gz
      archive_sha256=136b11efcf3edc3a3d8647994690ee929b9fd6547cdacb0796b706393b0a92ff
      wheel_member=dist/x86_64/arm_sdk-5.2.2-py3-none-any.whl
      wheel_name=arm_sdk-5.2.2-py3-none-any.whl
      wheel_sha256=4b22d7f0df396e93ec66304754a6bdfcb877d074bc2cbb18aee313f2c7c56c11
      ;;
    *)
      printf 'Unsupported SDK version: %s\n' "$1" >&2
      exit 2
      ;;
  esac
}

env_dir_for() {
  printf '%s/%s' "$data_root" "$1"
}

verify_file() {
  printf '%s  %s\n' "$1" "$2" | sha256sum --check --status
}

install_sdk() {
  local version=$1
  local supplied_wheel=${2:-}
  version_details "$version"
  command -v uv >/dev/null || { printf 'uv is required.\n' >&2; exit 1; }
  command -v curl >/dev/null || { printf 'curl is required.\n' >&2; exit 1; }
  command -v sha256sum >/dev/null || { printf 'sha256sum is required.\n' >&2; exit 1; }

  local version_root
  version_root=$(env_dir_for "$version")
  local download_root=$data_root/downloads
  local archive_path=$download_root/$archive_name
  local partial_path=$archive_path.part
  local wheel_path
  mkdir -p "$download_root"

  if [[ -n $supplied_wheel ]]; then
    wheel_path=$supplied_wheel
    [[ -f $wheel_path ]] || {
      printf 'Wheel file does not exist: %s\n' "$wheel_path" >&2
      exit 1
    }
    verify_file "$wheel_sha256" "$wheel_path" || {
      printf 'Wheel checksum verification failed: %s\n' "$wheel_path" >&2
      exit 1
    }
  else
    wheel_path=$download_root/$wheel_name
    if [[ ! -f $archive_path ]] || ! verify_file "$archive_sha256" "$archive_path"; then
      rm -f "$partial_path"
      curl --fail --location --output "$partial_path" "$archive_url"
      verify_file "$archive_sha256" "$partial_path" || {
        printf 'Checksum verification failed for %s.\n' "$archive_url" >&2
        rm -f "$partial_path"
        exit 1
      }
      mv "$partial_path" "$archive_path"
    fi

    if [[ $version == 5.1.6 ]]; then
      command -v unzip >/dev/null || { printf 'unzip is required.\n' >&2; exit 1; }
      unzip -p "$archive_path" "$wheel_member" > "$wheel_path"
    else
      command -v tar >/dev/null || { printf 'tar is required.\n' >&2; exit 1; }
      tar -xOzf "$archive_path" "$wheel_member" > "$wheel_path"
    fi
    verify_file "$wheel_sha256" "$wheel_path" || {
      printf 'Extracted wheel checksum verification failed.\n' >&2
      exit 1
    }
  fi

  uv python install "$sdk_python"
  local staging_root
  staging_root=$(mktemp -d "$data_root/.${version}.XXXXXX")
  if ! uv venv --relocatable --python "$sdk_python" "$staging_root"; then
    rm -rf "$staging_root"
    exit 1
  fi
  if ! uv pip install --python "$staging_root/bin/python" --constraint "$constraints_root/$version/constraints.txt" "$wheel_path"; then
    rm -rf "$staging_root"
    exit 1
  fi

  rm -rf "$version_root"
  mv "$staging_root" "$version_root"
  printf 'Installed AIRBOT SDK %s at %s\n' "$version" "$version_root"
}

require_version() {
  [[ $# -ge 1 ]] || usage
  version_details "$1"
  [[ -x $(env_dir_for "$1")/bin/python ]] || {
    printf 'SDK %s is not installed. Run: airbot-sdk install %s\n' "$1" "$1" >&2
    exit 1
  }
}

command_name=${1:-}
case $command_name in
  install)
    [[ $# -eq 2 || $# -eq 3 ]] || usage
    install_sdk "$2" "${3:-}"
    ;;
  run)
    [[ $# -ge 3 ]] || usage
    version=$2
    require_version "$version"
    shift 2
    [[ $1 != */* ]] || {
      printf 'The command must be an executable name from the SDK environment.\n' >&2
      exit 2
    }
    exec "$(env_dir_for "$version")/bin/$1" "${@:2}"
    ;;
  python)
    [[ $# -ge 2 ]] || usage
    version=$2
    require_version "$version"
    shift 2
    exec "$(env_dir_for "$version")/bin/python" "$@"
    ;;
  list)
    [[ $# -eq 1 ]] || usage
    for version in 5.1.6 5.2.2; do
      if [[ -x $(env_dir_for "$version")/bin/python ]]; then
        printf '%s installed at %s\n' "$version" "$(env_dir_for "$version")"
      else
        printf '%s not installed\n' "$version"
      fi
    done
    ;;
  *)
    usage
    ;;
esac
